# GEMINI_API_KEY: Required for Gemini AI script generation, TTS, and media processing
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Runtime Cloud Run or local dev URL
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
STORAGE_PATH="./data"

# Optional external video providers (Wan, LTX-Video, HunyuanVideo, CogVideoX, ComfyUI, etc.)
VIDEO_PROVIDER_URL=""
VIDEO_PROVIDER_API_KEY=""

# Optional external image providers (Stable Diffusion, FLUX, ComfyUI, Hugging Face, etc.)
IMAGE_PROVIDER_URL=""
IMAGE_PROVIDER_API_KEY=""

# Optional external TTS providers (Piper, Coqui XTTS, custom HTTP)
TTS_PROVIDER_URL=""
TTS_PROVIDER_API_KEY=""

# Optional external transcription providers (Whisper local/remote)
TRANSCRIPTION_PROVIDER_URL=""
TRANSCRIPTION_PROVIDER_API_KEY=""
